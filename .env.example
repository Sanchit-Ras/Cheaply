# ---------------------------------------------------------------------------
# Cheaply - root environment configuration template
# Copy to .env and fill in the secrets. docker-compose refuses to start
# without them; there are deliberately no working defaults for anything
# sensitive.
# ---------------------------------------------------------------------------

# PostgreSQL
POSTGRES_DB=cheaply_db
POSTGRES_USER=cheaply_user
# Any strong password; used by the db container and the backend.
POSTGRES_PASSWORD=

# Redis (cache + revoked-token store)
REDIS_PASSWORD=

# JWT signing secret. REQUIRED - the backend refuses to start without one of
# at least 32 bytes. Generate with:
#   openssl rand -hex 32
# or:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# Shared secret between the backend and the scraper service. The backend
# sends it as X-API-Key; the scraper rejects /scrape calls without it.
SCRAPER_API_KEY=

# Browser origins allowed to call the backend API (comma-separated, exact).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
