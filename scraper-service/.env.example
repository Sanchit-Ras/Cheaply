# ---------------------------------------------------------------------------
# Cheaply Scraper Service - environment configuration template
# Copy to .env and adjust. Every value below shows its default.
# ---------------------------------------------------------------------------

# Server
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=false
LOG_LEVEL=INFO

# Access control
# When set, every /scrape request must carry a matching X-API-Key header
# (the Spring Boot backend sends it when cheaply.scraper.api-key / the
# SCRAPER_API_KEY env var is set on its side - use the same value on both).
# Leave empty for local development only; this service starts real browsers
# on demand, so never expose it to a network without a key.
SCRAPER_API_KEY=

# Comma-separated browser origins allowed by CORS. Empty is correct as long
# as only the backend (server-to-server) calls this service.
CORS_ORIGINS=

MAX_QUERY_LENGTH=120

# Chrome / Selenium (optional; auto-detected in the container)
# CHROME_BIN=/usr/bin/google-chrome

# Scraper tuning
MAX_PRODUCTS_PER_STORE=10
SCRAPER_TIMEOUT_SECONDS=15
# Additional attempts after the first (1 = two attempts in total)
MAX_RETRIES=1
# Hard ceiling on one /scrape call. The backend's read timeout
# (cheaply.scraper.read-timeout-ms, default 60000) must stay ABOVE this.
SCRAPER_TOTAL_BUDGET_SECONDS=45
# Max headless Chrome instances across all concurrent requests.
MAX_CONCURRENT_BROWSERS=4
